{
  "name": "helpdesk-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API aplikacji HelpDesk korzystajace z Oracle Database",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.js",
    "auth:setup": "node scripts/setup-auth.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-auth.js",
    "staff:create": "node --env-file-if-exists=.env scripts/create-staff.js",
    "test:oracle": "node --env-file-if-exists=.env scripts/test-oracle-auth.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "oracledb": "26.0.0"
  }
}
