{
  "name": "helpdesk-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API aplikacji HelpDesk korzystajace z Oracle Database",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
